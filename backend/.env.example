# Choose groq (free-tier API), ollama (local), gemini, or openai (any OpenAI-compatible gateway:
# set AI_BASE_URL ending in /v1, AI_API_KEY, and an image-capable AI_MODEL).
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# Optional local alternative: AI_PROVIDER=ollama, AI_MODEL=qwen3-vl:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Design advisor: a text model with tool calling (defaults: groq openai/gpt-oss-120b, gemini gemini-2.5-flash, ollama qwen3:4b).
# Comma-separated list = fallbacks, best first. ADVISOR_BASE_URL / ADVISOR_API_KEY send it to another gateway.
ADVISOR_MODEL=
AI_BASE_URL=
AI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Use true for HTTPS hosting; false for local HTTP.
SOLAROPT_COOKIE_SECURE=false
