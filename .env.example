# Docker Compose only. Local AI settings belong in backend/.env.
DOMAIN=solaropt.example.com
DEMO_USER=demo
# Generate using: docker run --rm caddy:2-alpine caddy hash-password
# Wrap the resulting hash in single quotes when placing it in .env.
DEMO_PASSWORD_HASH=
RELEASE_TAG=local
AI_PROVIDER=groq
# Set a vision model available in your provider account.
AI_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
