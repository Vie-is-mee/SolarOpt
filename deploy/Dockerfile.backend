FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 solaropt \
    && mkdir -p /data /backups && chown solaropt:solaropt /data /backups
COPY --chown=solaropt:solaropt backend/app /app/app
COPY --chown=solaropt:solaropt ops /app/ops
USER solaropt
EXPOSE 8000
# Only Caddy can reach this port (no published ports); it replaces X-Forwarded-For with the real client,
# so the login throttle counts each visitor instead of one shared proxy address.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*"]
