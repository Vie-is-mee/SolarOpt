{$DOMAIN} {
    basic_auth {
        {$DEMO_USER} {$DEMO_PASSWORD_HASH}
    }
    request_body {
        max_size 40MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                response_header_timeout 120s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
